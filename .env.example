# ==============================================================================
# EXPENSE TRACKER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your secure credentials before running
# ==============================================================================

COMPOSE_PROJECT_NAME=expense_tracker
APP_DOMAIN=localhost

# PostgreSQL Database Credentials
POSTGRES_DB=expense_db
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=YourStrongDatabasePasswordHere123!
POSTGRES_PORT=5432

# pgAdmin 4 Administration Credentials
PGADMIN_DEFAULT_EMAIL=admin@expensetracker.com
PGADMIN_DEFAULT_PASSWORD=YourStrongPgAdminPasswordHere123!
PGADMIN_PORT=5050

# Application Settings
APP_PORT=3000
NODE_ENV=production

# Nginx Gateway Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YourStrongGrafanaPasswordHere123!
LOKI_PORT=3100
PROMTAIL_PORT=9080
CADVISOR_PORT=8080
